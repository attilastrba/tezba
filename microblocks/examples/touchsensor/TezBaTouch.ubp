module battitouchfinalLib
author Attila Strba
version 1 0
description 'Touch implementation for the Robot Tezba PCB. For more info read https://bitbucket.org/john_maloney/smallvm/issues/599/touchpin-not-working-with-raspberrypi-pico'
variables _PinValue _NoTouched pin

  spec 'r' 'myBlock' 'tasteGedrueckt _' 'auto' '10'

to myBlock pin {
  _NoTouched = 0
  repeat 10 {
    digitalWriteOp pin true
    waitMillis 1
    digitalWriteOp pin false
    _PinValue = (digitalReadOp pin 'up')
    if (not _PinValue) {
      _NoTouched = (_NoTouched + 1)
      if (_NoTouched > 4) {
        return (booleanConstant true)
      }
    }
  }
  return (booleanConstant false)
}

