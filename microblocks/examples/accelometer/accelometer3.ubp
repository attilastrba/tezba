module main
author unknown
version 1 0
description ''

script 261 82 {
whenStarted
'_xrp_initGyroscope'
'[sensors:i2cSetPins]' 6 7
forever {
  graphIt (xrp_readYawRate)
}
}

script 105 370 {
to '_xrp_initGyroscope' {}
}

